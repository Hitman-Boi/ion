# ===========================================
# Local Development Environment Variables
# ===========================================
# This file is pre-configured for use with docker-compose.localdev.yml
# Copy to .env or run scripts/localdev.sh to get started

# Database
# Connects to PostgreSQL running in docker container
# Uses 'learninghub' application user (not postgres superuser)
DATABASE_URL="postgresql://learninghub:learninghub@localhost:5432/learning_hub"

# Authentication (NextAuth.js)
# Local dev secret - DO NOT USE IN PRODUCTION
SESSION_ENCRYPTION_SECRET="localdev-secret-key-not-for-production-use"
APP_BASE_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD)
# Leave empty for local development (uses credentials provider)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Deployment Configuration
APP_PORT=3000
POSTHOG_PORT=8000

# PostHog Configuration
# The public URL where users access the analytics
POSTHOG_PUBLIC_HOST=http://localhost:8000
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8000

# Your PostHog Project API Key
# Get this from PostHog UI after first setup: Settings -> Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_localdev_placeholder_key
NEXT_PUBLIC_POSTHOG_CLIENT_API_KEY=phc_localdev_placeholder_key

# Internal URL for Next.js server to talk to PostHog
POSTHOG_INTERNAL_API_URL=http://localhost:8000
POSTHOG_INGEST_HOST=http://localhost:8000

# PostHog Secrets (for docker container)
POSTHOG_INSTANCE_SECRET_KEY=localdev-posthog-secret-not-for-production

# Content Quality Cron Job
CRON_SECRET="localdev-cron-secret"
