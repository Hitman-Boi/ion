# Database
DATABASE_URL="postgresql://user:password@localhost:5432/learning_hub"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/learning_hub_test"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"

# Azure AD
NEXTAUTH_AZURE_AD_CLIENT_ID="your-client-id"
NEXTAUTH_AZURE_AD_CLIENT_SECRET="your-client-secret"
NEXTAUTH_AZURE_AD_TENANT_ID="your-tenant-id"

# Redis
REDIS_URL="redis://localhost:6379"

# AWS S3
AWS_S3_BUCKET="your-bucket-name"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# Sentry
SENTRY_DSN="your-sentry-dsn"

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=1000
