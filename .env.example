# Database
# Connect to your PostgreSQL database
DATABASE_URL="postgresql://user:password@localhost:5432/learning_hub"

# Postgres Configuration (for Docker)
# These are used to initialize the Docker database
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=learning_hub

# Authentication (NextAuth.js)
# Generate a random secret: openssl rand -base64 32
SESSION_ENCRYPTION_SECRET="your-random-secret-key"
# Required for production/Docker environments
APP_BASE_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD)
# Register an app in Azure Portal to get these credentials
AZURE_AD_CLIENT_ID="your-client-id"
AZURE_AD_CLIENT_SECRET="your-client-secret"
AZURE_AD_TENANT_ID="your-tenant-id"

# Deployment Configuration
APP_PORT=3000
POSTHOG_PORT=8000

# PostHog Configuration
# The public URL where users access the analytics (UI and events)
# For local: http://localhost:8000
# For prod: https://analytics.your-domain.com
POSTHOG_PUBLIC_HOST=http://localhost:8000

# Internal URL for Next.js server to talk to PostHog (usually http://posthog:8000 in Docker)
POSTHOG_INTERNAL_API_URL=http://posthog:8000

# PostHog Secrets
# Generate a random string for inter-service security
POSTHOG_INSTANCE_SECRET_KEY=long_random_secret_string

# Your PostHog Project API Key (Get this from PostHog Settings -> Project Settings)
NEXT_PUBLIC_POSTHOG_CLIENT_API_KEY=phc_example_key

# Deployment Configuration
APP_PORT=3000
POSTHOG_PORT=8000

# PostHog Configuration
# The public URL where users access the analytics (UI and events)
# For local: http://localhost:8000
# For prod: https://analytics.your-domain.com
POSTHOG_PUBLIC_HOST=http://localhost:8000

# Internal URL for Next.js server to talk to PostHog (usually http://posthog:8000 in Docker)
POSTHOG_INGEST_HOST=http://posthog:8000

# Your PostHog Project API Key (Get this from PostHog Settings -> Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=phc_example_key

# Content Quality Cron Job
# Secret key to authenticate cron job requests
# Generate: openssl rand -base64 32
CRON_SECRET="your-cron-secret-key"
