generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(STUDENT)
  password      String? // Optional for OAuth users

  accounts    Account[]
  sessions    Session[]
  enrollments Enrollment[]
  submissions Submission[]
  progress    UserProgress[]
  skills      UserSkill[]
  
  // targetRoleId String?  @map("target_role_id") // Deprecated
  targetRoles  JobRole[] // Many-to-Many implicit relation

  // Instructor relations
  authoredCourses Course[] @relation("InstructorCourses")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Course {
  id            String    @id @default(uuid())
  title         String
  description   String?
  instructorId  String    @map("instructor_id")
  isPublic      Boolean   @default(false) @map("is_public")
  gradingPolicy Json?     @map("grading_policy") // { "cutoffs": ..., "weights": ... }
  deletedAt     DateTime? @map("deleted_at")

  instructor User @relation("InstructorCourses", fields: [instructorId], references: [id])

  chapters    Chapter[]
  enrollments Enrollment[]
  skills      Skill[]

  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  LearningPathItem LearningPathItem[]

  @@map("courses")
}

model Enrollment {
  id       String     @id @default(uuid())
  userId   String     @map("user_id")
  courseId String     @map("course_id")
  mode     String     @default("audit") // 'audit', 'verified'
  isActive Boolean    @default(true) @map("is_active")
  grade    Decimal?   @db.Decimal(5, 2)
  role     CourseRole @default(STUDENT)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Submission {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  resourceId    String   @map("resource_id")
  answerData    Json     @map("answer_data")
  scoreRaw      Decimal  @map("score_raw") @db.Decimal(5, 2)
  scorePossible Decimal  @map("score_possible") @db.Decimal(5, 2)
  submittedAt   DateTime @default(now()) @map("submitted_at")
  isLate        Boolean  @default(false) @map("is_late")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource TopicResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

// LTI Integration
model LtiInstallation {
  id           String @id @default(uuid())
  clientId     String @map("client_id")
  issuer       String
  deploymentId String @map("deployment_id")
  jwksUrl      String @map("jwks_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, issuer])
  @@map("lti_installations")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseRole {
  STUDENT
  INSTRUCTOR
  MODERATOR
}

model JobRole {
  id          String  @id @default(uuid())
  title       String  @unique
  description String?

  skills        Skill[] // Skills required for this role
  learningPaths LearningPath[] // Paths recommended for this role
  candidates    User[] // Users aiming for this role

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("job_roles")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  category   String?
  roles      JobRole[]
  courses    Course[]
  userSkills UserSkill[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model LearningPath {
  id          String  @id @default(uuid())
  title       String
  description String?

  roles JobRole[]

  items LearningPathItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  level PathLevel @default(BEGINNER)

  @@map("learning_paths")
}

enum PathLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model LearningPathItem {
  id             String       @id @default(uuid())
  learningPathId String       @map("learning_path_id")
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  // Polymorphic-ish: An item can be EITHER a Course OR a Chapter
  courseId String? @map("course_id")
  course   Course? @relation(fields: [courseId], references: [id])

  chapterId String?  @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id])

  orderIndex Int @map("order_index")

  @@unique([learningPathId, orderIndex]) // Prevent duplicate steps
  @@map("learning_path_items")
}

model SkillTarget {
  id           String @id @default(uuid())
  skillName    String @map("skill_name")
  targetCount  Int    @map("target_count")
  currentCount Int    @default(0) @map("current_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skill_targets")
}

model UserSkill {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  skillId    String   @map("skill_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

// Micro-Learning & Atomic Tracking Models

model Chapter {
  id          String  @id @default(uuid())
  courseId    String  @map("course_id")
  title       String
  description String?
  sortOrder   Int     @map("sort_order")

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics Topic[]

  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  LearningPathItem LearningPathItem[]

  @@map("chapters")
}

model Topic {
  id          String  @id @default(uuid())
  chapterId   String  @map("chapter_id")
  title       String
  description String?
  sortOrder   Int     @map("sort_order")

  chapter   Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  resources TopicResource[]
  progress  UserProgress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("topics")
}

enum ResourceType {
  VIDEO
  PDF
  QUIZ
}

model TopicResource {
  id         String       @id @default(uuid())
  topicId    String       @map("topic_id")
  type       ResourceType
  title      String // e.g. "Intro Video", "Handout PDF", "Concept Check"
  contentUrl String?      @map("content_url") // For Video/PDF
  quizData   Json?        @map("quiz_data") // For Quiz
  sortOrder  Int          @default(0) @map("sort_order")

  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submissions Submission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("topic_resources")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UserProgress {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  topicId String @map("topic_id")

  // The 'Truth' of the Atoms
  videoCompleted Boolean @default(false) @map("video_completed")
  pdfCompleted   Boolean @default(false) @map("pdf_completed")
  quizPassed     Boolean @default(false) @map("quiz_passed")

  // The aggregated state
  isTopicComplete Boolean @default(false) @map("is_topic_complete") // Computed: video && pdf && quiz

  quizScore Int?     @map("quiz_score") // The actual grade (0-100)
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_progress")
}
