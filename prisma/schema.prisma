generator client {
  provider = "prisma-client-js"
}

generator testClient {
  provider = "prisma-client-js"
  output   = "./prisma/test-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Test database configuration
generator test {
  provider = "prisma-client-js"
  output   = "./prisma/test-client"
  db       = "postgresql"
  url      = env("TEST_DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  courses   Course[]
  enrollments Enrollment[]
  progress    UserProgress[]
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  instructor  User     @relation(fields: [instructorId], references: [id])
  instructorId Int
  modules     Module[]
  enrollments Enrollment[]
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UnitType {
  VIDEO
  PDF
  LINK
  SCORM
}

enum ProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

model Module {
  id        Int      @id @default(autoincrement())
  title     String
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  units     CourseUnit[]
  order     Int      @default(0)
}

model CourseUnit {
  id                 Int      @id @default(autoincrement())
  title              String
  type               UnitType
  contentPath        String?  // Path to file on disk or external URL
  moduleId           Int
  module             Module   @relation(fields: [moduleId], references: [id])
  order              Int      @default(0)
  completionCriteria Json?    // e.g., { "minTime": 300, "pages": 10 }
  progress           UserProgress[]
}

model UserProgress {
  id        Int            @id @default(autoincrement())
  userId    Int
  unitId    Int
  user      User           @relation(fields: [userId], references: [id])
  unit      CourseUnit     @relation(fields: [unitId], references: [id])
  status    ProgressStatus @default(LOCKED)
  data      Json?          // e.g., { "lastPosition": 120, "completedPages": [1,2] }
  updatedAt DateTime       @updatedAt

  @@unique([userId, unitId])
}